# name: test/sql/compaction/merge_adjacent_read_batch_postgres.test
# description: on PostgreSQL a compaction reads the files of every table as one pipeline
# group: [compaction]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/merge_adjacent_read_batch_postgres', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.a AS SELECT 1 AS i

statement ok
INSERT INTO dl.a VALUES (2)

statement ok
CREATE TABLE dl.b AS SELECT 1 AS i

statement ok
INSERT INTO dl.b VALUES (2)

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

query II
SELECT table_name, files_processed FROM ducklake_merge_adjacent_files('dl') ORDER BY ALL
----
a	2
b	2

query I
SELECT count(*) = 1
  OR NOT EXISTS (SELECT 1 FROM duckdb_functions() WHERE function_name = 'postgres_pipeline_result')
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE contains(query, 'ducklake_file_partition_value') AND NOT contains(query, 'DELETE')
----
true
