# name: test/sql/compaction/merge_adjacent_unchanged_schema.test
# description: Merging adjacent files of an older schema version reads no schema of that version when the table did not change since
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/merge_adjacent_unchanged_schema', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t (i INTEGER);

statement ok
INSERT INTO ducklake.t VALUES (1);

statement ok
INSERT INTO ducklake.t VALUES (2);

# a newer schema version, so the files of t have an older one
statement ok
CREATE TABLE ducklake.u (i INTEGER);

statement ok
FROM ducklake.u

statement ok
CALL enable_logging('DuckLakeMetadata')

query II
SELECT files_processed, files_created FROM ducklake_merge_adjacent_files('ducklake')
----
2	1

statement ok
CALL disable_logging()

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE regexp_matches(query, 'schema_version\s*=\s*\d') OR contains(query, 'ducklake_column')
----
0

query I
SELECT i FROM ducklake.t ORDER BY i
----
1
2
