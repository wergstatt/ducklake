# name: test/sql/cleanup/cleanup_old_files_commit_batch.test
# description: a cleanup removes the files from the deletion schedule with the COMMIT of its transaction
# group: [cleanup]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/cleanup_old_files_commit_batch', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DELETE FROM dl.t

statement ok
CALL ducklake_expire_snapshots('dl', versions => [1])

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

query I
SELECT count(*) FROM ducklake_cleanup_old_files('dl', cleanup_all => true)
----
1

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
CALL disable_logging()

# where a batch carries the COMMIT, as that of the INSERT, the DELETE of the cleanup goes with it
query I
SELECT count(*) FILTER (query LIKE '%DELETE FROM%ducklake_files_scheduled_for_deletion%COMMIT') = 1
  OR count(*) FILTER (query LIKE '%COMMIT') = 0
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
true

query I
SELECT count(*) FROM __ducklake_metadata_dl.ducklake_files_scheduled_for_deletion
----
0
