# name: test/sql/tags/tags_expire_read_once.test
# description: An expiry reads the snapshot tags once with each read of the snapshots it selects from
# group: [tags]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/tags_expire_read_once')

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

statement ok
CALL ducklake_expire_snapshots('dl', older_than => now())

query II
SELECT
  count(*) FILTER (query LIKE '%SELECT tag_name%') > 0,
  count(*) FILTER (query LIKE '%SELECT tag_name%') = count(*) FILTER (query LIKE '%commit_extra_info, next_file_id%')
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
true	true
