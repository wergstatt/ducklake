# name: test/sql/retry/postgres_retry_cache_clear.test
# description: a failed commit on Postgres clears the cache of the metadata catalog without a query
# group: [retry]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS pg

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS retry_cache_clear CASCADE')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/retry_cache_clear', METADATA_SCHEMA 'retry_cache_clear')

statement ok
SET immediate_transaction_mode=true

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
INSERT INTO dl.t VALUES (1)

statement ok con2
INSERT INTO dl.t VALUES (2)

statement ok con1
COMMIT

statement ok
CALL enable_logging('PostgresQueryLog', storage = 'memory')

# the commit collides with the first one, rolls back, clears the cache and retries
statement ok con2
COMMIT

statement ok
CALL disable_logging()

# the retry is the only transaction after the rollback
query I
SELECT count(*) FROM duckdb_logs_parsed('PostgresQueryLog') WHERE query LIKE 'BEGIN%'
----
1

query II
SELECT count(*), sum(i) FROM dl.t
----
2	3

statement ok
DETACH dl

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA retry_cache_clear CASCADE')
