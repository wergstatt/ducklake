# name: test/sql/data_inlining/many_inlined_rows_in_commit.test
# description: a commit sends more than 100 inlined rows with its other statements, with as many metadata queries as one row
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/many_inlined_rows_in_commit', DATA_INLINING_ROW_LIMIT 5000)

statement ok
CREATE TABLE dl.t (i INTEGER, s VARCHAR)

# the first insert creates the inlined data table
statement ok
INSERT INTO dl.t VALUES (-1, 'first')

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

statement ok
INSERT INTO dl.t VALUES (0, 'one')

statement ok
CALL disable_logging()

statement ok
CREATE TABLE one_row AS SELECT count(*) AS queries FROM duckdb_logs_parsed('DuckLakeMetadata')

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

statement ok
INSERT INTO dl.t SELECT i, 'row ' || i FROM range(1, 5001) t(i)

statement ok
CALL disable_logging()

# without postgres_execute_pipeline, a catalog on PostgreSQL inserts more than 100 rows after the batch
query I
SELECT count(*) = (SELECT queries FROM one_row)
  OR NOT EXISTS (SELECT 1 FROM duckdb_functions() WHERE function_name = 'postgres_execute_pipeline')
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
true

query III
SELECT count(*), sum(i), max(s) FROM dl.t
----
5002	12502499	row 999

query I
SELECT count(*) FROM ducklake_list_files('dl', 't')
----
0
