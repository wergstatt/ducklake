# name: test/sql/data_inlining/scan_reads_in_one_round_trip_postgres.test
# description: on PostgreSQL a scan reads its file list, its inlined file deletions and its inlined rows in one round trip
# group: [data_inlining]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CONNECTION postgres:dbname=ducklakedb

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/scan_reads_in_one_round_trip_postgres', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t AS FROM range(100) t(i)

statement ok
INSERT INTO dl.t VALUES (100)

statement ok
DELETE FROM dl.t WHERE i = 5

statement ok
BEGIN

query I
SELECT count(*) FROM dl.t
----
100

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

query I
SELECT sum(i) FROM dl.t
----
5045

statement ok
CALL disable_logging()

statement ok
COMMIT

# the scans of the kept results cost no request
query I
SELECT count(*) = 1 OR NOT EXISTS (SELECT 1 FROM duckdb_functions() WHERE function_name = 'postgres_pipeline_result')
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE NOT contains(query, 'postgres_pipeline_result')
----
true
