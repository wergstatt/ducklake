# name: test/sql/data_inlining/flush_without_superseded_tables_skips_registry.test
# description: A flush of tables without superseded inlined tables does not scan the inlined table registry
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/flush_without_superseded_tables_skips_registry', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE ducklake.t (i INTEGER)

statement ok
INSERT INTO ducklake.t VALUES (1)

statement ok
CALL enable_logging('DuckLakeMetadata')

statement ok
CALL ducklake_flush_inlined_data('ducklake')

statement ok
CALL disable_logging()

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata') WHERE query LIKE '%ducklake_inlined_data_tables%'
----
0
