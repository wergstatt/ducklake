# name: test/sql/transaction/commit_retry_snapshot_read.test
# description: A commit retry takes the latest snapshot from its conflict check instead of reading it again
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/commit_retry_snapshot_read')

statement ok
SET immediate_transaction_mode=true

statement ok
CREATE TABLE ducklake.t (i INTEGER)

statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
INSERT INTO ducklake.t VALUES (1)

statement ok con2
INSERT INTO ducklake.t VALUES (2)

statement ok con1
COMMIT

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

# the commit collides with the first one and retries
statement ok con2
COMMIT

statement ok
CALL disable_logging()

# the conflict check is the only read of the latest snapshot
query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata') WHERE query LIKE '%MAX(snapshot_id)%'
----
1

query II
SELECT count(*), sum(i) FROM ducklake.t
----
2	3
