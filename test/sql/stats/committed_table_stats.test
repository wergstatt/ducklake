# name: test/sql/stats/committed_table_stats.test
# description: The table stats that a commit keeps for the next snapshot are those that a read of the catalog returns
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/committed_table_stats.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/committed_table_stats', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t (i INTEGER, s VARCHAR)

# the catalog stores whether a column holds NULL values, not how many
statement ok
INSERT INTO ducklake.t VALUES (1, NULL)

statement ok
SET VARIABLE kept = (SELECT stats(i)::VARCHAR || stats(s)::VARCHAR FROM ducklake.t LIMIT 1)

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake

query I
SELECT stats(i)::VARCHAR || stats(s)::VARCHAR = getvariable('kept') FROM ducklake.t LIMIT 1
----
true

statement ok
INSERT INTO ducklake.t VALUES (2, 'b')

# dropping a whole file while rows remain deletes the column stats, which the next insert does not write again
statement ok
DELETE FROM ducklake.t WHERE i = 1

statement ok
INSERT INTO ducklake.t VALUES (3, 'c')

statement ok
SET VARIABLE kept = (SELECT stats(i)::VARCHAR || stats(s)::VARCHAR FROM ducklake.t LIMIT 1)

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake

query I
SELECT stats(i)::VARCHAR || stats(s)::VARCHAR = getvariable('kept') FROM ducklake.t LIMIT 1
----
true
