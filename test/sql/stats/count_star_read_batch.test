# name: test/sql/stats/count_star_read_batch.test
# description: COUNT(*) reads the row counts of the data files and of the inlined rows as one batch of two reads
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/count_star_read_batch', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t AS FROM range(100) t(i)

statement ok
INSERT INTO dl.t VALUES (100), (101)

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

query I
SELECT count(*) FROM dl.t
----
102

query II
SELECT count(*) FILTER (WHERE contains(query, 'ducklake_delete_file')) > 0,
  count(*) FILTER (WHERE contains(query, 'SELECT COUNT(*)') AND contains(query, 'ducklake_inlined_data_')) > 0
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
true	true
