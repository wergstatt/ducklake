# name: test/sql/stats/net_row_count_table_filter.test
# description: The net row count of a table only scans the data files of that table
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/net_row_count_table_filter', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.many_files(i INTEGER)

statement ok
INSERT INTO ducklake.many_files FROM range(10)

statement ok
INSERT INTO ducklake.many_files FROM range(10, 20)

statement ok
INSERT INTO ducklake.many_files FROM range(20, 30)

statement ok
DELETE FROM ducklake.many_files WHERE i % 10 = 0

statement ok
CREATE TABLE ducklake.counted(i INTEGER)

statement ok
INSERT INTO ducklake.counted FROM range(10)

statement ok
DELETE FROM ducklake.counted WHERE i < 3

# a new attach starts without a cached count
statement ok
DETACH ducklake

statement ok
CALL enable_logging(level = 'debug', storage = 'memory')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/net_row_count_table_filter', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

statement ok
CALL truncate_duckdb_logs()

query I
SELECT count(*) FROM counted
----
7

# Every scan of the data files that Postgres receives for the count is limited to the table (table_id 2)
query I
SELECT CASE WHEN (SELECT catalog_type FROM settings()) = 'postgres' THEN
	(SELECT count(*) > 0 AND bool_and(contains(query, '"table_id" = 2'))
	 FROM (SELECT message AS query FROM duckdb_logs WHERE type = 'PostgresQueryLog') logs
	 WHERE contains(query, '"ducklake_data_file" '))
	ELSE true END
----
true

# The count of a table is unaffected by the files and deletes of the other tables
query I
SELECT count(*) FROM many_files
----
27
