# name: test/sql/stats/kept_table_stats_without_stats_write_postgres.test
# description: on PostgreSQL a delete that writes no stats keeps the stats of every table, so a lone writer reads none again
# group: [stats]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CONNECTION postgres:dbname=ducklakedb

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/kept_table_stats_without_stats_write_postgres', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
CREATE TABLE dl.u (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2)

statement ok
INSERT INTO dl.u VALUES (1)

# a delete writes a delete file and no stats
statement ok
DELETE FROM dl.t WHERE i = 1

# stats changed without a snapshot show whether a statement reads them again
statement ok
UPDATE __ducklake_metadata_dl.ducklake_table_column_stats SET max_value = '999'

query I
SELECT stats(i)::VARCHAR LIKE '%999%' FROM dl.u LIMIT 1
----
false

# a commit without stats on a catalog that it did not load, such as an expiry after an attach, keeps nothing
statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/kept_table_stats_without_stats_write_postgres')

statement ok
CALL ducklake_expire_snapshots('dl', versions => [1])
