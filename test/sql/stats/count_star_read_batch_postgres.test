# name: test/sql/stats/count_star_read_batch_postgres.test
# description: on PostgreSQL the two reads of a COUNT(*) reach the server as one pipeline
# group: [stats]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/count_star_read_batch_postgres', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t AS FROM range(100) t(i)

statement ok
INSERT INTO dl.t VALUES (100), (101)

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

query I
SELECT count(*) FROM dl.t
----
102

# the row count of the data files is read in the same pipeline as the row count of the inlined rows
query I
SELECT count(*) = 1 AND bool_and(contains(query, 'ducklake_inlined_data_'))
  OR NOT EXISTS (SELECT 1 FROM duckdb_functions() WHERE function_name = 'postgres_pipeline_result')
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE contains(query, 'del.delete_count')
----
true
