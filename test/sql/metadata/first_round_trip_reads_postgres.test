# name: test/sql/metadata/first_round_trip_reads_postgres.test
# description: on PostgreSQL a select reads what another session changed with the snapshot, in one request before its file list
# group: [metadata]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CONNECTION postgres:dbname=ducklakedb

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/first_round_trip_reads_postgres', DATA_INLINING_ROW_LIMIT 0)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS other (DATA_PATH '{DATA_PATH}/first_round_trip_reads_postgres', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

query I
SELECT sum(i) FROM dl.t
----
1

statement ok
ALTER TABLE other.t ADD COLUMN j INTEGER

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

query I
SELECT sum(i) FROM dl.t
----
1

statement ok
CALL disable_logging()

# the catalog, schema versions and stats come with the snapshot, the scans of kept results reach no server
query I
SELECT count(*) = 2 OR NOT EXISTS (SELECT 1 FROM duckdb_functions() WHERE function_name = 'postgres_pipeline_result')
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE NOT contains(query, 'postgres_pipeline_result')
----
true

statement ok
CALL truncate_duckdb_logs()

statement ok
INSERT INTO other.t VALUES (2, 2)

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

query I
SELECT sum(i) FROM dl.t
----
3

statement ok
CALL disable_logging()

query I
SELECT count(*) = 2 OR NOT EXISTS (SELECT 1 FROM duckdb_functions() WHERE function_name = 'postgres_pipeline_result')
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE NOT contains(query, 'postgres_pipeline_result')
----
true

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

query I
SELECT sum(i) FROM dl.t
----
3

statement ok
CALL disable_logging()

# the server skips every read whose rows the caches hold
query I
SELECT count(*) = 2 OR NOT EXISTS (SELECT 1 FROM duckdb_functions() WHERE function_name = 'postgres_pipeline_result')
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE NOT contains(query, 'postgres_pipeline_result')
----
true
